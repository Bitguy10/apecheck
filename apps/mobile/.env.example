# ─────────────────────────────────────────────────────────────
# ApeCheck mobile (Expo) environment
# Copy to `apps/mobile/.env`. Only PUBLIC values belong here.
#
# EXPO_PUBLIC_* vars are embedded in the app bundle at build time — they are NOT
# secret. That's fine: the mobile app never holds third-party data keys. It scans
# through the web API (server keys stay on the server) and talks to Supabase using
# the anon key under Row Level Security.
#
# For EAS builds, set these with `eas env` / EAS secrets, or in app.json → extra.
# ─────────────────────────────────────────────────────────────

# Base URL of the deployed ApeCheck web app (hosts POST /api/scan).
# For local device testing, use your machine's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=https://apecheck.vercel.app

# Supabase — same project as web. Anon key is safe to ship (RLS enforces access).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
