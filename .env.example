# ─────────────────────────────────────────────────────────────
# ApeCheck environment variables
# Copy to `apps/web/.env.local` (web) and configure EAS secrets (mobile).
# All third-party keys are SERVER-SIDE ONLY. Never prefix secret keys with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key: SERVER ONLY. Used by API routes + cron to bypass RLS for the global scan cache.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Data source API keys (server-side only) ---
# Helius RPC (https://helius.dev) — free tier
HELIUS_API_KEY=your-helius-key
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-key

# Birdeye (https://birdeye.so) — free tier public key
BIRDEYE_API_KEY=your-birdeye-key

# RugCheck (https://rugcheck.xyz) — public API, JWT optional for higher limits
RUGCHECK_JWT=

# DexScreener + Jupiter need no key (public endpoints)

# --- Cron / internal ---
# Shared secret so only Vercel Cron (or you) can hit /api/internal/check-dumps
CRON_SECRET=generate-a-long-random-string

# --- Push notifications ---
# Expo push works without a key. OneSignal (web push) optional:
# App ID is safe to expose (needed by the browser SDK); REST key is SERVER ONLY.
ONESIGNAL_APP_ID=
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Telegram bot (optional) ---
# Create a bot with @BotFather → get the token + the bot's @username.
# Token is SERVER ONLY. Username is public (used to build the t.me deep link).
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Optional shared secret Telegram echoes back on each webhook call (recommended).
TELEGRAM_WEBHOOK_SECRET=
#
# The bot runs in one of two modes (a Telegram webhook needs a PUBLIC https URL,
# so it cannot reach a dev server on localhost):
#
#   LOCAL DEV — long-poll relay, no tunnel/deploy needed. In one terminal run the
#   web app (npm run dev:web); in another run the relay:
#       npm run bot:dev
#   It pulls updates via getUpdates and forwards them to your local webhook route.
#   (If your dev server isn't on :3001, set WEBHOOK_TARGET=http://localhost:PORT/api/telegram/webhook)
#
#   PRODUCTION — register the webhook once after deploy (NEXT_PUBLIC_APP_URL must be https):
#       curl -X POST "$NEXT_PUBLIC_APP_URL/api/internal/telegram-setup?key=$CRON_SECRET"
#   Check status any time:  curl "$NEXT_PUBLIC_APP_URL/api/internal/telegram-setup?key=$CRON_SECRET"

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
