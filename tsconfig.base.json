{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@apecheck/core": ["./packages/core/src/index.ts"],
      "@apecheck/core/*": ["./packages/core/src/*"],
      "@apecheck/api-clients": ["./packages/api-clients/src/index.ts"],
      "@apecheck/api-clients/*": ["./packages/api-clients/src/*"],
      "@apecheck/ui": ["./packages/ui/src/index.ts"],
      "@apecheck/ui/*": ["./packages/ui/src/*"]
    }
  }
}
